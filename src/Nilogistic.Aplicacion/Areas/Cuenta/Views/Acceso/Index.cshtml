@{
    Layout = "_LayoutCuenta";
    ViewData["Title"] = "Iniciar sesión";
}
<h1 class="h3 mb-1">Iniciar sesión</h1>
<p class="text-secondary mb-4">Accede a tu cuenta de Nilogistic.</p>

@if (Model.RequiereSegundoFactor)
{
    <div class="alert alert-info" role="alert">@Nilogistic.DTO.Identidad.MensajesInicioSesion.SegundoFactorPendiente</div>
}
else if (!ViewData.ModelState.IsValid)
{
    <div id="cuenta-error" class="alert alert-danger" role="alert" asp-validation-summary="All"></div>
}

<form method="post" action="@Nilogistic.Aplicacion.Areas.Cuenta.Controllers.AccesoController.Ruta" asp-antiforgery="true">
    <div class="mb-3">
        <label for="cuenta-correo" class="form-label">Correo electrónico</label>
        <input id="cuenta-correo" class="form-control" type="email" name="Correo" value="@Model.Correo"
               autocomplete="username" inputmode="email" maxlength="@Nilogistic.Aplicacion.Models.Identidad.AccesoViewModel.LongitudMaximaCorreo"
               required aria-describedby="@(ViewData.ModelState.IsValid ? null : "cuenta-error")" />
    </div>
    <div class="mb-4">
        <label for="cuenta-clave" class="form-label">Contraseña</label>
        <input id="cuenta-clave" class="form-control" type="password" name="Contrasena" value=""
               autocomplete="current-password" maxlength="@Nilogistic.Aplicacion.Models.Identidad.AccesoViewModel.LongitudMaximaContrasena"
               required aria-describedby="@(ViewData.ModelState.IsValid ? null : "cuenta-error")" />
    </div>
    <button class="btn btn-primary w-100 mb-3" type="submit">Iniciar sesión</button>
</form>
