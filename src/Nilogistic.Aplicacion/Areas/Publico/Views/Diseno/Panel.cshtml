@{
    Layout = "_LayoutPanel";
    ViewData["Title"] = "Galería de diseño · Panel";
    ViewData["Migas"] = new List<MigaDePan>
    {
        new("Panel", "/admin"),
        new("Solicitudes de alta", null)
    };
    ViewData["RutaActiva"] = "/admin/solicitudes";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="mb-0">Solicitudes de alta</h1>
    <button class="btn btn-primary" type="button">Nueva solicitud</button>
</div>
<div class="alert alert-success" role="status"><strong>Guardado.</strong> La solicitud de Logística del Pacífico S. A. se aprobó. (Datos de ejemplo)</div>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive" tabindex="0" role="region" aria-label="Solicitudes recientes">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Solicitudes recientes</caption>
                <thead>
                    <tr><th scope="col">Solicitante</th><th scope="col">Tipo</th><th scope="col">Estado</th></tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Carlos Mejía</th><td>Empresa</td><td><span class="nl-status nl-status--pendiente">Pendiente</span></td></tr>
                    <tr><th scope="row">Ana Lacayo</th><td>Profesional</td><td><span class="nl-status nl-status--revision">En revisión</span></td></tr>
                    <tr><th scope="row">Logística del Pacífico S. A.</th><td>Empresa</td><td><span class="nl-status nl-status--aprobada">Aprobada</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
