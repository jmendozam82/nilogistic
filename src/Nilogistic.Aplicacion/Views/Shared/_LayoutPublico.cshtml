@{
    var consentimiento = Context.ObtenerConsentimientoCookies();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_CabezaComun" />
    <partial name="_MetadatosSeo" />
    <partial name="_EstilosBase" />
    @RenderSection("Estilos", required: false)
</head>
<body>
    <partial name="_SaltarContenido" />
    @if (consentimiento.Decision != EstadoDecision.Vigente && ViewData["SinBannerCookies"] is not true)
    {
        <partial name="_BannerCookies" />
    }
    <div class="nl-topbar on-dark">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>Conectando profesionales, potenciando la logística.</span>
            <partial name="_SesionUsuario" />
        </div>
    </div>
    <partial name="_CabeceraPublica" />
    <main id="main" tabindex="-1">
        @RenderBody()
    </main>
    <partial name="_PiePublico" />
    <partial name="_ScriptsBase" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
