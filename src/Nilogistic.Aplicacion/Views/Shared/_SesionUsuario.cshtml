@if (User.Identity?.IsAuthenticated == true)
{
    <span class="d-inline-flex align-items-center flex-wrap gap-2">
        <a href="/cuenta">Mi cuenta</a>
        @if (User.IsInRole(Nilogistic.Utility.Seguridad.NombresRol.Gerente) || User.IsInRole(Nilogistic.Utility.Seguridad.NombresRol.Administrador))
        {
            <a href="/admin">Panel</a>
        }
        <partial name="_CerrarSesion" model="@("nl-sesion-cerrar")" />
    </span>
}
else
{
    <span class="d-inline-flex align-items-center flex-wrap gap-2">
        <a href="/cuenta/iniciar-sesion">Iniciar sesión</a>
    </span>
}
