{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "TareasSegundoPlano": {
    "Habilitado": true,
    "IntervaloSondeoSegundos": 15,
    "MargenReservaSegundos": 60,
    "EsperaBaseReintentoSegundos": 5
  },
  "Correo": {
    "LoteMaximo": 20,
    "ReservaSegundos": 600,
    "MaxReintentos": 3,
    "EsperaBaseReintentoSegundos": 60,
    "FactorEspera": 4,
    "PausaEntreEnviosMs": 600,
    "ConservarDias": 30,
    "VaciarCuerposAlEnviar": true,
    "UrlBaseSitio": "https://localhost",
    "DominiosVerificados": ["nilogistic.com"],
    "Remitentes": {
      "Transaccional": "Nilogistic <no-reply@nilogistic.com>",
      "Contacto": "Nilogistic <no-reply@nilogistic.com>"
    }
  },
  "Resend": {
    "UrlBase": "https://api.resend.com"
  },
  "Contenido": {
    "QuienesSomos": {
      "Publicado": false
    }
  },
  "AllowedHosts": "*"
}
