{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "TareasSegundoPlano": {
    "Habilitado": true,
    "IntervaloSondeoSegundos": 15,
    "MargenReservaSegundos": 60,
    "EsperaBaseReintentoSegundos": 5
  },
  "AllowedHosts": "*"
}
