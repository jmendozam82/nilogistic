<Project>
  <!-- Gestión central de versiones. Los rangos flotantes (10.0.*) toman el último parche LTS;
       fijar con packages.lock.json cuando se estabilice (D-082). Verificar en el primer restore. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Datos -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Extensiones -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <!-- Excepcion autorizada por Jorge (D-101): binder estandar para enlazar secciones de configuracion -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <!-- API -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- Pruebas. FluentAssertions queda en 7.x: desde la 8.0 exige licencia comercial (D-083) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="AngleSharp" Version="1.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Accesibilidad en navegador (HU-037 Pase B; SUP-1): unicos paquetes nuevos del Pase B.
         Microsoft.Playwright fija el driver y el script playwright.ps1; la version del navegador
         instalado debe corresponder a esta version (ver runbook docs/runbooks/diseno.md). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <!-- Saneamiento de HTML legal (HU-044 Pase B; SUP-3). Fijado en 9.2.1039 (CVE-2026-25543). -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>
</Project>
